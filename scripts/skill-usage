#!/usr/bin/env python3
"""Count skill loads in Claude Code and Codex session logs.

Usage: scripts/skill-usage [--format summary|events|both] [--since YYYY-MM-DD]
       [--until YYYY-MM-DD] [--machine-label LABEL] [--home PATH]

Claude Code loads are Skill tool calls and user slash commands. Skill tool calls
are user-invoked when the user prompt names the skill as /name or says use,
load, or run <name>; they are hook-invoked when a preceding [mode] reminder or
hook names the skill; other calls are model-invoked. Codex has no Skill tool.
Its loads are tool calls that read a path ending in <skill>/SKILL.md. Text in
the session preamble is not a load. A Codex read is user-invoked when the user
message names the skill or contains $<skill>, hook-invoked when a preceding
[mode] reminder or hook names it, and model-invoked otherwise.

Counts deduplicate by session, skill, and turn. raw_reads records the number
of matching tool calls within each counted turn.
"""
import argparse
import collections
import datetime
import glob
import json
import os
import re
import sys


THIRD_PARTY = {
    "find-skills", "herdr", "hyperframes", "media-use", "notion-cli",
    "playwright-cli", "plannotator-annotate", "plannotator-last",
    "plannotator-review",
}


def names(home):
    found = set()
    roots = [os.path.join(home, "src/skills/skills"),
             os.path.join(home, "src/skills-personal/skills")]
    for root in roots:
        for path in glob.glob(os.path.join(root, "**/SKILL.md"), recursive=True):
            try:
                with open(path, encoding="utf-8") as f:
                    lines = f.read().splitlines()
                if lines and lines[0] == "---":
                    for line in lines[1:]:
                        if line == "---":
                            break
                        match = re.match(r"^name:\s*([A-Za-z0-9_.-]+)\s*$", line)
                        if match:
                            found.add(match.group(1))
                            break
            except OSError:
                continue
    # The listed copied skills include the hyperframes-* family.
    for store in (".agents/skills", ".claude/skills"):
        root = os.path.join(home, store)
        for path in glob.glob(os.path.join(root, "*", "SKILL.md")):
            folder = os.path.basename(os.path.dirname(path))
            if folder in THIRD_PARTY or folder.startswith("hyperframes-"):
                found.add(folder)
        for name in THIRD_PARTY:
            if os.path.isfile(os.path.join(root, name, "SKILL.md")):
                found.add(name)
        for path in glob.glob(os.path.join(root, "hyperframes-*", "SKILL.md")):
            found.add(os.path.basename(os.path.dirname(path)))
    return sorted(found)


def stamp(value):
    if not value:
        return None
    try:
        dt = datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        return dt.date()
    except (ValueError, TypeError):
        return None


def in_range(value, since, until):
    day = stamp(value)
    return day is not None and since <= day <= until


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(str(x.get("text", "")) for x in content
                         if isinstance(x, dict) and x.get("type") in ("text", "input_text"))
    return ""


def mode_for(skill, user_text, hook_text, codex=False):
    name = re.escape(skill)
    user = (rf"\${name}\b|\b{name}\b" if codex else
            rf"/{name}\b|\b(?:use|load|run)\s+(?:the\s+)?{name}\b")
    if re.search(user, user_text, re.I):
        return "user"
    if re.search(r"\[(?:mode|hook)\].*?" + name + r"\b", hook_text, re.I | re.S):
        return "hook"
    return "model"


def skill_from_path(value, skill_set):
    for match in re.finditer(r"(?:^|[/\\])([^/\\]+)[/\\]SKILL\.md(?:$|[\s\"'])", value):
        if match.group(1) in skill_set:
            return match.group(1)
    return None


def claude_files(home, since):
    # A log not changed since before the window cannot hold a load in the window.
    earliest_mtime = datetime.datetime.combine(since - datetime.timedelta(days=1), datetime.time()).timestamp()
    roots = glob.glob(os.path.join(home, ".claude/projects/*"))
    for root in roots:
        for path in glob.glob(os.path.join(root, "*.jsonl")):
            try:
                if os.path.getmtime(path) < earliest_mtime:
                    continue
            except OSError:
                continue
            yield path, False
        for path in glob.glob(os.path.join(root, "subagents", "*.jsonl")):
            try:
                if os.path.getmtime(path) < earliest_mtime:
                    continue
            except OSError:
                continue
            yield path, True


def codex_files(home, since, until):
    for pattern in (".codex/sessions/**/*.jsonl", ".codex/archived_sessions/*.jsonl"):
        for path in glob.glob(os.path.join(home, pattern), recursive=True):
            match = re.search(r"/sessions/(\d{4})/(\d{2})/(\d{2})/", path)
            if match:
                day = datetime.date(*(int(x) for x in match.groups()))
                if day < since - datetime.timedelta(days=1) or day > until + datetime.timedelta(days=1):
                    continue
            yield path, False


def parse_claude(path, subagent, skill_set, since, until):
    events = []
    recognized = False
    malformed = 0
    user_text = hook_text = ""
    pending_hook_text = ""
    turn = 0
    try:
        f = open(path, encoding="utf-8")
    except OSError:
        return events, recognized, malformed
    with f:
        for line_no, line in enumerate(f, 1):
            try:
                row = json.loads(line)
            except (ValueError, TypeError):
                malformed += 1
                continue
            kind = row.get("type")
            recognized = recognized or kind in ("user", "assistant")
            if kind == "user":
                user_text = text_of((row.get("message") or {}).get("content"))
                turn += 1
                hook_text, pending_hook_text = pending_hook_text, ""
                for skill in skill_set:
                    if re.search(r"<command-name>\s*/" + re.escape(skill) + r"\s*</command-name>", user_text, re.I):
                        if in_range(row.get("timestamp"), since, until):
                            events.append((skill, "user", row.get("sessionId") or os.path.basename(path)[:-6], row.get("timestamp", ""), path, line_no, subagent, turn))
            if kind in ("system", "developer"):
                body = text_of((row.get("message") or {}).get("content"))
                if "[mode]" in body.lower() or "[hook]" in body.lower():
                    pending_hook_text += "\n" + body
            msg = row.get("message")
            if not isinstance(msg, dict):
                continue
            for block in msg.get("content", []) if isinstance(msg.get("content"), list) else []:
                if not isinstance(block, dict) or block.get("type") != "tool_use" or block.get("name") != "Skill":
                    continue
                skill = (block.get("input") or {}).get("skill")
                if not isinstance(skill, str):
                    continue
                if skill not in skill_set:
                    stripped = skill.split(":", 1)[-1]
                    if stripped not in skill_set:
                        continue
                    skill = stripped
                if not in_range(row.get("timestamp"), since, until):
                    continue
                events.append((skill, mode_for(skill, user_text, hook_text), row.get("sessionId") or os.path.basename(path)[:-6], row.get("timestamp", ""), path, line_no, subagent, turn))
    return events, recognized, malformed


def command_strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, list):
        for item in value:
            yield from command_strings(item)
    elif isinstance(value, dict):
        for key, item in value.items():
            if key in ("command", "cmd", "script", "input", "arguments"):
                yield from command_strings(item)


def is_read_call(name, command):
    if name and "apply_patch" in name.lower():
        return False
    return bool(re.search(r"(?:^|[;&|{(\s\"':])(?:cat|sed|head|nl|rg)\s+", command))


def parse_codex(path, skill_set, since, until):
    events = []
    recognized = False
    malformed = 0
    user_text = hook_text = ""
    pending_hook_text = ""
    turn = 0
    session_id = os.path.basename(path).removesuffix(".jsonl")
    try:
        f = open(path, encoding="utf-8")
    except OSError:
        return events, recognized, malformed
    with f:
        for line_no, line in enumerate(f, 1):
            try:
                row = json.loads(line)
            except (ValueError, TypeError):
                malformed += 1
                continue
            typ, payload = row.get("type"), row.get("payload") or {}
            recognized = recognized or typ in ("session_meta", "event_msg", "response_item", "turn_context", "world_state")
            if typ == "session_meta" and isinstance(payload, dict):
                session_id = payload.get("id") or payload.get("session_id") or session_id
            if typ == "response_item" and isinstance(payload, dict):
                if payload.get("type") == "message" and payload.get("role") == "user":
                    user_text = text_of(payload.get("content"))
                    turn += 1
                    hook_text, pending_hook_text = pending_hook_text, ""
                if payload.get("type") == "message" and payload.get("role") in ("system", "developer"):
                    body = text_of(payload.get("content"))
                    if "[mode]" in body.lower() or "[hook]" in body.lower():
                        pending_hook_text += "\n" + body
                if payload.get("type") in ("function_call", "custom_tool_call"):
                    args = payload.get("arguments", payload.get("input", {}))
                    joined = "\n".join(command_strings(args))
                    skill = skill_from_path(joined, skill_set) if is_read_call(payload.get("name", ""), joined) else None
                    if skill and in_range(row.get("timestamp"), since, until):
                        events.append((skill, mode_for(skill, user_text, hook_text, True), session_id, row.get("timestamp", ""), path, line_no, False, turn))
            if typ == "response_item" and isinstance(payload, dict) and payload.get("type") == "message" and payload.get("role") == "user":
                continue
            # Some Codex versions store direct function calls at the top level.
            if typ in ("function_call", "custom_tool_call"):
                joined = "\n".join(command_strings(row))
                skill = skill_from_path(joined, skill_set) if is_read_call(row.get("name", ""), joined) else None
                if skill and in_range(row.get("timestamp"), since, until):
                    events.append((skill, mode_for(skill, user_text, hook_text, True), session_id, row.get("timestamp", ""), path, line_no, False, turn))
    return events, recognized, malformed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--format", choices=("summary", "events", "both"), default="summary")
    parser.add_argument("--since", default="2026-08-06")
    parser.add_argument("--until", default="2026-11-04")
    parser.add_argument("--machine-label", default="macbook")
    parser.add_argument("--home", default=os.path.expanduser("~"))
    parser.add_argument("--skills-list", help="comma-separated skill names shared across machines")
    parser.add_argument("--summary-output", help="write the summary TSV to this path")
    parser.add_argument("--events-output", help="write the events TSV to this path")
    args = parser.parse_args()
    try:
        since = datetime.date.fromisoformat(args.since)
        until = datetime.date.fromisoformat(args.until)
    except ValueError as err:
        parser.error(str(err))
    if since > until:
        parser.error("--since must not be after --until")
    home = os.path.abspath(os.path.expanduser(args.home))
    skill_list = sorted(set(args.skills_list.split(","))) if args.skills_list else names(home)
    if args.skills_list and any(not re.fullmatch(r"[A-Za-z0-9_.-]+", name) for name in skill_list):
        parser.error("--skills-list contains an invalid skill name")
    if not skill_list:
        parser.error("no skill names found under the configured skill roots")
    skill_set = set(skill_list)
    all_events = []
    files = 0
    parse_errors = 0
    unrecognized_files = 0
    malformed_lines = 0
    for harness, source in (("claude", claude_files(home, since)), ("codex", codex_files(home, since, until))):
        for path, subagent in source:
            files += 1
            try:
                found, recognized, malformed = (parse_claude(path, subagent, skill_set, since, until) if harness == "claude"
                                                else parse_codex(path, skill_set, since, until))
                unrecognized_files += not recognized
                malformed_lines += malformed
                all_events.extend((e[0], args.machine_label, harness, *e[1:]) for e in found)
            except (OSError, UnicodeError, ValueError, TypeError):
                parse_errors += 1
    # Deduplicate calls within each session, skill, and turn; retain raw reads.
    grouped = collections.defaultdict(list)
    for event in all_events:
        skill, machine, harness, mode, sid, ts, path, line, subagent, turn = event
        grouped[(skill, machine, harness, sid, turn)].append(event)
    deduped = []
    for key, rows in grouped.items():
        deduped.append((rows[0], len(rows)))
    event_lines = ["skill\tmachine\tharness\tmode\tsession_id\ttimestamp\tfile\tline\tsubagent\traw_reads"]
    for event, raw_reads in sorted(deduped, key=lambda x: (x[0][1], x[0][2], x[0][0], x[0][5], x[0][7])):
        skill, machine, harness, mode, sid, ts, path, line, subagent, turn = event
        event_lines.append(f"{skill}\t{machine}\t{harness}\t{mode}\t{sid}\t{ts}\t{path}\t{line}\t{int(subagent)}\t{raw_reads}")
    summary_lines = ["skill\tmachine\tharness\tloads\tuser\thook\tmodel\tsessions(n)\tsession_ids(comma, capped at 20)\traw_reads"]
    for skill in skill_list:
        for harness in ("claude", "codex"):
            rows = [(event, raw) for event, raw in deduped if event[0] == skill and event[2] == harness]
            counts = collections.Counter(event[3] for event, _ in rows)
            sessions = sorted({event[4] for event, _ in rows})
            summary_lines.append(f"{skill}\t{args.machine_label}\t{harness}\t{len(rows)}\t{counts['user']}\t{counts['hook']}\t{counts['model']}\t{len(sessions)}\t{','.join(sessions[:20])}\t{sum(raw for _, raw in rows)}")
    if args.format == "both":
        if not args.summary_output or not args.events_output:
            parser.error("--format both requires --summary-output and --events-output")
        with open(args.summary_output, "w", encoding="utf-8") as f:
            f.write("\n".join(summary_lines) + "\n")
        with open(args.events_output, "w", encoding="utf-8") as f:
            f.write("\n".join(event_lines) + "\n")
    elif args.format == "events":
        print("\n".join(event_lines))
    else:
        print("\n".join(summary_lines))
    print(f"# files={files} parse_errors={parse_errors} unrecognized_files={unrecognized_files} malformed_lines={malformed_lines} skills={len(skill_list)}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
