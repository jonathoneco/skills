#!/usr/bin/env python3
import shutil
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src" / "variants"
DIST = ROOT / "dist"

for harness in ("pi", "claude", "codex"):
    out = DIST / harness / "skills"
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    source = SRC / harness
    if not source.exists():
        continue
    for skill in sorted(source.iterdir()):
        if not skill.is_dir():
            continue
        if not (skill / "SKILL.md").exists():
            continue
        shutil.copytree(skill, out / skill.name)
